{
  "manifest_version": 3,
  "name": "fbspider bridge",
  "version": "3.0.0",
  "description": "Drives your own logged-in Facebook session (ad accounts / pages / pixels / comments) for the fbspider-clone dashboard. For managing your own accounts.",
  "permissions": ["cookies", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://graph.facebook.com/*",
    "https://adsmanager-graph.facebook.com/*",
    "https://business.facebook.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "fbspider bridge", "default_icon": "icons/icon128.png" },
  "icons": { "128": "icons/icon128.png" },
  "web_accessible_resources": [
    {
      "resources": ["inject-recorder.js"],
      "matches": ["https://*.facebook.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content-fb.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.github.io/*",
        "https://*.pages.dev/*",
        "https://*.netlify.app/*",
        "https://*.vercel.app/*",
        "https://new.fbspider.com/*",
        "https://go.fbspider.com/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
